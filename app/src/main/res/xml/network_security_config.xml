<?xml version="1.0" encoding="utf-8"?>
<!-- A model on the home network usually has no certificate, so plain HTTP has to work.
     The app warns when that goes beyond a private address. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
